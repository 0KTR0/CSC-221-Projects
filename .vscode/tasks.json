            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build: ingredient-adjuster",
            "type": "process",
            "command": "make",
            "args": ["ingredient-adjuster"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build: interest-earned",
            "type": "process",
            "command": "make",
            "args": ["interest-earned"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build: lottery-tickets",
            "type": "process",
            "command": "make",
            "args": ["lottery-tickets"],
            "problemMatcher": ["$gcc"]
        }
    ]
}
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Create build directory",
			"type": "shell",
			"command": "mkdir",
			"args": [
				"-p",
				"${workspaceFolder}/build"
			],
			"problemMatcher": []
		},
		{
			"label": "Build Ingredient Adjuster",
			"type": "shell",
			"command": "g++",
			"args": [
				"-std=c++17",
				"-Wall",
				"-Wextra",
				"-pedantic",
				"${workspaceFolder}/Main.cpp",
				"-o",
				"${workspaceFolder}/build/IngredientAdjuster"
			],
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"dependsOn": "Create build directory",
			"dependsOrder": "sequence"
		},
		{
			"label": "Run Ingredient Adjuster",
			"type": "shell",
			"command": "${workspaceFolder}/build/IngredientAdjuster",
			"dependsOn": "Build Ingredient Adjuster",
			"dependsOrder": "sequence",
			"problemMatcher": []
		}
	]
}